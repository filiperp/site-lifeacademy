APP_NAME="Life Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Em desenvolvimento o SQLite basta. Em produção use MySQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=site_lifeacademy
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# A entrega da compra para a API roda em fila. Em produção use redis ou
# database + um worker (php artisan queue:work), nunca `sync`: se a API da
# Life Academy estiver fora do ar, `sync` faz o webhook do Asaas falhar.
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# Hotmart — checkout e webhook
###############################################################################

# Painel Hotmart > Ferramentas > Webhook. Chega no header X-HOTMART-HOTTOK e é
# a única coisa que separa uma venda real de um POST forjado.
HOTMART_HOTTOK=

# Hotmart Developers > suas credenciais. Só a sincronizacao de preco depende
# delas; o webhook funciona sem.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=

HOTMART_CHECKOUT_URL=https://pay.hotmart.com
HOTMART_SYNC_ENABLED=true
# Variação percentual a partir da qual hotmart:sync avisa em vez de aplicar.
HOTMART_SYNC_ALERT_THRESHOLD=25

###############################################################################
# API Life Academy (projeto la-app)
###############################################################################

LA_API_URL=https://api.lifeacademy.pro
LA_APP_URL=https://app.lifeacademy.pro
LA_SUPPORT_EMAIL=suporte@lifeacademy.pro

# Rota que recebe a compra paga. A rota do WooCommerce já existe e faz tudo
# o que precisamos, então o site novo não exige alteração na API.
LA_PURCHASE_ENDPOINT=/api/woocommerce/order

# Precisa ser idêntico ao segredo usado em WooCommerceController::webhook().
LA_WEBHOOK_SECRET=

LA_REFERENCE_PREFIX=HM
LA_MAX_ATTEMPTS=8

###############################################################################

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lifeacademy.pro"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
